<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Apply Connections — Urbana Bridge Generator"
    Width="680" Height="840"
    MinWidth="560" MinHeight="600"
    MaxHeight="900"
    ResizeMode="CanResizeWithGrip"
    WindowStartupLocation="CenterScreen"
    FontFamily="Segoe UI"
    Background="#F5F7FA">

    <Window.Resources>
        <!-- ====================================================== -->
        <!-- Colour palette — Urbana house style (matches Bridge Setup) -->
        <!-- ====================================================== -->
        <SolidColorBrush x:Key="NavyPrimary"   Color="#1B3A6B"/>
        <SolidColorBrush x:Key="NavyLight"     Color="#2E5FA3"/>
        <SolidColorBrush x:Key="BgPage"        Color="#F5F7FA"/>
        <SolidColorBrush x:Key="BgCard"        Color="#FFFFFF"/>
        <SolidColorBrush x:Key="BgInput"       Color="#FAFBFC"/>
        <SolidColorBrush x:Key="BorderInput"   Color="#C5D0E0"/>
        <SolidColorBrush x:Key="TextPrimary"   Color="#1A2340"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#5A7BA8"/>
        <SolidColorBrush x:Key="TextMuted"     Color="#8A97AE"/>
        <SolidColorBrush x:Key="AccentBlue"    Color="#A8C4E8"/>
        <SolidColorBrush x:Key="Success"       Color="#2E7D32"/>
        <SolidColorBrush x:Key="SuccessBg"     Color="#E8F5E9"/>
        <SolidColorBrush x:Key="Warning"       Color="#E65100"/>
        <SolidColorBrush x:Key="WarningBg"     Color="#FFF3E0"/>
        <SolidColorBrush x:Key="ErrorClr"      Color="#C62828"/>
        <SolidColorBrush x:Key="ErrorBg"       Color="#FFEBEE"/>
        <SolidColorBrush x:Key="InfoBg"        Color="#E3F2FD"/>
        <SolidColorBrush x:Key="PlaceholderBg" Color="#F0F4FA"/>
        <SolidColorBrush x:Key="BtnCancelBg"   Color="#E8EEF7"/>

        <!-- ====================================================== -->
        <!-- Card style                                              -->
        <!-- ====================================================== -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background"     Value="{StaticResource BgCard}"/>
            <Setter Property="CornerRadius"   Value="6"/>
            <Setter Property="Padding"        Value="14,12"/>
            <Setter Property="Margin"         Value="0,0,0,10"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#CCCCCC" BlurRadius="6" ShadowDepth="1" Opacity="0.30"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Section label (navy, semibold) -->
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource NavyPrimary}"/>
            <Setter Property="Margin"     Value="0,0,0,8"/>
        </Style>

        <!-- Field label -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin"     Value="0,0,0,4"/>
        </Style>

        <!-- Run button (navy, rounded) -->
        <Style x:Key="BtnRun" TargetType="Button">
            <Setter Property="Background"      Value="{StaticResource NavyPrimary}"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Height"          Value="36"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="5" Padding="18,0">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource NavyLight}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary / cancel button -->
        <Style x:Key="BtnCancel" TargetType="Button">
            <Setter Property="Background"      Value="{StaticResource BtnCancelBg}"/>
            <Setter Property="Foreground"      Value="{StaticResource NavyPrimary}"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="Height"          Value="36"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="5" Padding="18,0">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#D0DCF0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Select beam button — slightly different accent -->
        <Style x:Key="BtnSelect" TargetType="Button">
            <Setter Property="Background"      Value="#2E5FA3"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="FontSize"        Value="11"/>
            <Setter Property="Height"          Value="32"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4" Padding="14,0">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1B3A6B"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary TabControl override -->
        <Style x:Key="UrbanaTab" TargetType="TabControl">
            <Setter Property="Background"      Value="{StaticResource BgPage}"/>
            <Setter Property="BorderBrush"     Value="{StaticResource BorderInput}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="0"/>
        </Style>

        <!-- Primary TabItem -->
        <Style x:Key="UrbanaTabItem" TargetType="TabItem">
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="FontWeight"      Value="Normal"/>
            <Setter Property="Foreground"      Value="{StaticResource TextSecondary}"/>
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="22,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder"
                                Background="{TemplateBinding Background}"
                                BorderThickness="0,0,0,3"
                                BorderBrush="Transparent"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="BorderBrush"
                                        Value="{StaticResource NavyPrimary}"/>
                                <Setter Property="Foreground" Value="{StaticResource NavyPrimary}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource NavyPrimary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary (connection-type) TabItem — smaller -->
        <Style x:Key="SecondaryTabItem" TargetType="TabItem">
            <Setter Property="FontSize"        Value="11"/>
            <Setter Property="FontWeight"      Value="Normal"/>
            <Setter Property="Foreground"      Value="{StaticResource TextSecondary}"/>
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="12,7"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="STabBorder"
                                Background="{TemplateBinding Background}"
                                BorderThickness="0,0,0,2"
                                BorderBrush="Transparent"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="STabBorder" Property="BorderBrush"
                                        Value="{StaticResource NavyLight}"/>
                                <Setter Property="Foreground" Value="{StaticResource NavyPrimary}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource NavyPrimary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBox — Urbana input style -->
        <Style x:Key="UrbanaCombo" TargetType="ComboBox">
            <Setter Property="Background"               Value="{StaticResource BgInput}"/>
            <Setter Property="BorderBrush"              Value="{StaticResource BorderInput}"/>
            <Setter Property="BorderThickness"          Value="1"/>
            <Setter Property="Padding"                  Value="8,0"/>
            <Setter Property="FontSize"                 Value="11"/>
            <Setter Property="Height"                   Value="30"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- Placeholder card style -->
        <Style x:Key="PlaceholderCard" TargetType="Border">
            <Setter Property="Background"     Value="{StaticResource PlaceholderBg}"/>
            <Setter Property="CornerRadius"   Value="6"/>
            <Setter Property="Padding"        Value="20,16"/>
            <Setter Property="Margin"         Value="0,8,0,0"/>
            <Setter Property="BorderBrush"    Value="{StaticResource BorderInput}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- Selected beam info card -->
        <Style x:Key="BeamInfoCard" TargetType="Border">
            <Setter Property="Background"     Value="{StaticResource InfoBg}"/>
            <Setter Property="CornerRadius"   Value="5"/>
            <Setter Property="Padding"        Value="12,8"/>
            <Setter Property="Margin"         Value="0,0,0,10"/>
            <Setter Property="BorderBrush"    Value="{StaticResource AccentBlue}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- Status / result card -->
        <Style x:Key="StatusCard" TargetType="Border">
            <Setter Property="Background"     Value="{StaticResource BgCard}"/>
            <Setter Property="CornerRadius"   Value="5"/>
            <Setter Property="Padding"        Value="12,10"/>
            <Setter Property="Margin"         Value="0,0,0,10"/>
            <Setter Property="BorderBrush"    Value="{StaticResource BorderInput}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- ====================================================== -->
        <!-- Connection Direction toggle-switch style (shared)       -->
        <!-- Unchecked = Default (left pill active, navy)            -->
        <!-- Checked   = Reversed (right pill active, orange)        -->
        <!-- ====================================================== -->
        <Style x:Key="ConnDirToggle" TargetType="ToggleButton">
            <Setter Property="Cursor"           Value="Hand"/>
            <Setter Property="BorderThickness"  Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Track"
                                Background="#D0DCF0"
                                CornerRadius="11"
                                Padding="2"
                                Width="144" Height="24">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <!-- Default pill (left, active by default) -->
                                <Border x:Name="DefaultPill"
                                        Grid.Column="0"
                                        Background="{StaticResource NavyPrimary}"
                                        CornerRadius="9"
                                        Margin="0,0,1,0">
                                    <TextBlock x:Name="DefaultText"
                                               Text="Default"
                                               FontSize="10" FontWeight="SemiBold"
                                               Foreground="White"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <!-- Reverse pill (right, inactive by default) -->
                                <Border x:Name="ReversePill"
                                        Grid.Column="1"
                                        Background="Transparent"
                                        CornerRadius="9"
                                        Margin="1,0,0,0">
                                    <TextBlock x:Name="ReverseText"
                                               Text="Reverse"
                                               FontSize="10" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextMuted}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- Reversed state: right pill becomes active (orange) -->
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="DefaultPill" Property="Background" Value="Transparent"/>
                                <Setter TargetName="DefaultText" Property="Foreground" Value="{StaticResource TextMuted}"/>
                                <Setter TargetName="ReversePill" Property="Background" Value="{StaticResource Warning}"/>
                                <Setter TargetName="ReverseText" Property="Foreground" Value="White"/>
                            </Trigger>
                            <!-- Disabled state -->
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Track" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <!-- ================================================================ -->
    <!-- Root layout                                                       -->
    <!-- ================================================================ -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Header banner -->
            <RowDefinition Height="*"/>     <!-- Tab content   -->
            <RowDefinition Height="Auto"/>  <!-- Footer bar    -->
        </Grid.RowDefinitions>

        <!-- ============================================================ -->
        <!-- Header banner                                                 -->
        <!-- ============================================================ -->
        <Border Grid.Row="0"
                Background="{StaticResource NavyPrimary}"
                Padding="20,14">
            <StackPanel>
                <TextBlock Text="⬡  Apply Connections"
                           FontSize="17" FontWeight="Bold"
                           Foreground="White"/>
                <TextBlock Text="Urbana Bridge Generator  |  Structural Connection Automation  |  Concrete Deck · Timber Deck"
                           FontSize="10.5"
                           Foreground="{StaticResource AccentBlue}"
                           Margin="0,3,0,0"/>
            </StackPanel>
        </Border>

        <!-- ============================================================ -->
        <!-- Main TabControl — Concrete Deck / Timber Deck                -->
        <!-- ============================================================ -->
        <TabControl Grid.Row="1"
                    x:Name="BridgeTypeTabs"
                    Style="{StaticResource UrbanaTab}">

            <!-- ======================================================== -->
            <!-- TAB: Concrete Deck                                        -->
            <!-- ======================================================== -->
            <TabItem Header="Concrete Deck"
                     Style="{StaticResource UrbanaTabItem}">
                <TabControl x:Name="ConcreteConnectionTabs"
                            Margin="8,6,8,0"
                            Background="Transparent"
                            BorderThickness="0,0,0,1"
                            BorderBrush="{StaticResource BorderInput}">

                    <!-- Beam–Beam (Concrete) -->
                    <TabItem Header="Beam–Beam" Style="{StaticResource SecondaryTabItem}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Padding="14,12,14,8">
                            <StackPanel>
                                <!-- Section intro -->
                                <TextBlock Text="Target Beam Type-to-Beam Connection"
                                           Style="{StaticResource SectionLabel}"/>
                                <TextBlock Text="Select a main beam and apply predefined structural connections at all detected beam-to-beam joints."
                                           FontSize="10.5" Foreground="{StaticResource TextSecondary}"
                                           TextWrapping="Wrap" Margin="0,0,0,14"/>

                                <!-- Connection Type -->
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="Connection Type" Style="{StaticResource SectionLabel}"/>
                                        <ComboBox x:Name="ConnectionTypeCombo_Concrete"
                                                  Style="{StaticResource UrbanaCombo}"
                                                  Margin="0,0,0,0"/>
                                        <TextBlock x:Name="ConnectionTypeHint_Concrete"
                                                   Text="Choose the structural connection definition to apply at each joint."
                                                   FontSize="10" Foreground="{StaticResource TextMuted}"
                                                   Margin="0,6,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>

                                <!-- Target Beam Type Selection -->
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="Target Beam Type" Style="{StaticResource SectionLabel}"/>
                                        <Button x:Name="BtnSelectBeam_Concrete"
                                                Content="⊙  Select Reference Beam"
                                                Style="{StaticResource BtnSelect}"
                                                HorizontalAlignment="Left"
                                                Width="200"
                                                Margin="0,0,0,10"/>
                                        <!-- Selected beam info card -->
                                        <Border x:Name="SelectedBeamCard_Concrete"
                                                Style="{StaticResource BeamInfoCard}">
                                            <StackPanel>
                                                <TextBlock Text="Selected Member"
                                                           FontSize="9" FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextMuted}"
                                                           Margin="0,0,0,3"/>
                                                <TextBlock x:Name="SelectedBeamLabel_Concrete"
                                                           Text="— no beam selected —"
                                                           FontSize="11"
                                                           Foreground="{StaticResource NavyPrimary}"
                                                           FontWeight="SemiBold"
                                                           TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <!-- Status / Result -->
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="Result" Style="{StaticResource SectionLabel}"/>
                                        <Border x:Name="ResultCard_Concrete"
                                                Style="{StaticResource StatusCard}">
                                            <TextBlock x:Name="ResultText_Concrete"
                                                       Text="Ready. Select a connection type and a main beam, then click Apply."
                                                       FontSize="11"
                                                       Foreground="{StaticResource TextSecondary}"
                                                       TextWrapping="Wrap"/>
                                        </Border>

                                        <!-- Apply + Connection Direction row —— Beam-Beam Concrete -->
                                        <Grid Margin="0,4,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Button Grid.Column="0"
                                                    x:Name="BtnApplyBeamBeam_Concrete"
                                                    Content="▶   Apply Beam–Beam Connections"
                                                    Style="{StaticResource BtnRun}"
                                                    Width="260"/>
                                            <StackPanel Grid.Column="2"
                                                        VerticalAlignment="Center"
                                                        Margin="16,0,0,0">
                                                <TextBlock Text="Connection Direction"
                                                           FontSize="9" FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextMuted}"
                                                           Margin="0,0,0,3"/>
                                                <ToggleButton x:Name="DirectionToggle_Concrete"
                                                              Style="{StaticResource ConnDirToggle}"
                                                              ToolTip="Default: lower ElementId = Input 1.  Reverse: swaps Input 1 / Input 2."/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- Bearer–Beam (Concrete) — ACTIVE -->
                    <TabItem Header="Bearer–Beam" Style="{StaticResource SecondaryTabItem}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Padding="14,12,14,8">
                            <StackPanel>
                                <!-- Section intro -->
                                <TextBlock Text="Bearer-to-Main-Beam Connection"
                                           Style="{StaticResource SectionLabel}"/>
                                <TextBlock Text="Select a Reference Beam type and a Reference Bearer type. Connections are applied at every valid project-wide Bearer-to-Beam joint."
                                           FontSize="10.5" Foreground="{StaticResource TextSecondary}"
                                           TextWrapping="Wrap" Margin="0,0,0,14"/>

                                <!-- Connection Type -->
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="Connection Type" Style="{StaticResource SectionLabel}"/>
                                        <ComboBox x:Name="ConnectionTypeCombo_BB_Concrete"
                                                  Style="{StaticResource UrbanaCombo}"
                                                  Margin="0,0,0,0"/>
                                        <TextBlock Text="Choose the structural connection definition to apply at each Bearer-Beam joint."
                                                   FontSize="10" Foreground="{StaticResource TextMuted}"
                                                   Margin="0,6,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>

                                <!-- Target Beam & Bearer Selection (Side by Side) -->
                                <Grid Margin="0,0,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Left Column: Target Beam Type -->
                                    <Border Grid.Column="0" Style="{StaticResource Card}" VerticalAlignment="Stretch">
                                        <StackPanel>
                                            <TextBlock Text="Target Beam Type" Style="{StaticResource SectionLabel}"/>
                                            <Button x:Name="BtnSelectBBBeam_Concrete"
                                                    Content="⊙  Select Reference Beam"
                                                    Style="{StaticResource BtnSelect}"
                                                    HorizontalAlignment="Stretch"
                                                    Margin="0,0,0,10"/>
                                            <Border x:Name="SelectedBBBeamCard_Concrete"
                                                    Style="{StaticResource BeamInfoCard}">
                                                <StackPanel>
                                                    <TextBlock Text="Reference Beam"
                                                               FontSize="9" FontWeight="SemiBold"
                                                               Foreground="{StaticResource TextMuted}"
                                                               Margin="0,0,0,3"/>
                                                    <TextBlock x:Name="SelectedBBBeamLabel_Concrete"
                                                               Text="— no beam selected —"
                                                               FontSize="11"
                                                               Foreground="{StaticResource NavyPrimary}"
                                                               FontWeight="SemiBold"
                                                               TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Border>

                                    <!-- Right Column: Target Bearer Type -->
                                    <Border Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Stretch">
                                        <StackPanel>
                                            <TextBlock Text="Target Bearer Type" Style="{StaticResource SectionLabel}"/>
                                            <Button x:Name="BtnSelectBBBearer_Concrete"
                                                    Content="⊙  Select Reference Bearer"
                                                    Style="{StaticResource BtnSelect}"
                                                    HorizontalAlignment="Stretch"
                                                    Margin="0,0,0,10"/>
                                            <Border x:Name="SelectedBBBearerCard_Concrete"
                                                    Style="{StaticResource BeamInfoCard}">
                                                <StackPanel>
                                                    <TextBlock Text="Reference Bearer"
                                                               FontSize="9" FontWeight="SemiBold"
                                                               Foreground="{StaticResource TextMuted}"
                                                               Margin="0,0,0,3"/>
                                                    <TextBlock x:Name="SelectedBBBearerLabel_Concrete"
                                                               Text="— no bearer selected —"
                                                               FontSize="11"
                                                               Foreground="{StaticResource NavyPrimary}"
                                                               FontWeight="SemiBold"
                                                               TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- Status / Result -->
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="Result" Style="{StaticResource SectionLabel}"/>
                                        <Border x:Name="ResultCard_BB_Concrete"
                                                Style="{StaticResource StatusCard}">
                                            <TextBlock x:Name="ResultText_BB_Concrete"
                                                       Text="Ready. Select a connection type, a Reference Beam, and a Reference Bearer, then click Apply."
                                                       FontSize="11"
                                                       Foreground="{StaticResource TextSecondary}"
                                                       TextWrapping="Wrap"/>
                                        </Border>

                                        <!-- Apply + Connection Direction row -->
                                        <Grid Margin="0,4,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Button Grid.Column="0"
                                                    x:Name="BtnApplyBearerBeam_Concrete"
                                                    Content="▶   Apply Bearer–Beam Connections"
                                                    Style="{StaticResource BtnRun}"
                                                    Width="270"/>
                                            <StackPanel Grid.Column="2"
                                                        VerticalAlignment="Center"
                                                        Margin="16,0,0,0">
                                                <TextBlock Text="Connection Direction"
                                                           FontSize="9" FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextMuted}"
                                                           Margin="0,0,0,3"/>
                                                <ToggleButton x:Name="DirectionToggle_BB_Concrete"
                                                              Style="{StaticResource ConnDirToggle}"
                                                              ToolTip="Default: Beam = Input 1, Bearer = Input 2.  Reverse: swaps Input 1 / Input 2."/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- Post–Beam (Concrete) — PLACEHOLDER -->
                    <TabItem Header="Post–Beam" Style="{StaticResource SecondaryTabItem}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14,12,14,8">
                            <StackPanel>
                                <TextBlock Text="Handrail Post-to-Beam Connection"
                                           Style="{StaticResource SectionLabel}"/>
                                <Border Style="{StaticResource PlaceholderCard}">
                                    <StackPanel>
                                        <TextBlock Text="⏳  Coming in a later stage"
                                                   FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextSecondary}"
                                                   Margin="0,0,0,6"/>
                                        <TextBlock Text="Connection automation for this component will be added in a later development stage."
                                                   FontSize="11" Foreground="{StaticResource TextMuted}"
                                                   TextWrapping="Wrap"/>
                                        <!-- Connection Direction — placeholder (disabled until workflow is implemented) -->
                                        <StackPanel Margin="0,14,0,0" Opacity="0.55">
                                            <TextBlock Text="Connection Direction"
                                                       FontSize="10" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextSecondary}"

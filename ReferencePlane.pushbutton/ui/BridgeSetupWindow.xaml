<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Bridge Setup — Urbana Bridge Generator"
    Width="620" Height="860"
    MinWidth="540" MinHeight="600"
    MaxHeight="900"
    ResizeMode="CanResizeWithGrip"
    WindowStartupLocation="CenterScreen"
    FontFamily="Segoe UI"
    Background="#F5F7FA">

    <Window.Resources>
        <!-- ====================================================== -->
        <!-- Colour palette — Urbana house style                     -->
        <!-- ====================================================== -->
        <SolidColorBrush x:Key="NavyPrimary"   Color="#1B3A6B"/>
        <SolidColorBrush x:Key="NavyLight"     Color="#2E5FA3"/>
        <SolidColorBrush x:Key="BgPage"        Color="#F5F7FA"/>
        <SolidColorBrush x:Key="BgCard"        Color="#FFFFFF"/>
        <SolidColorBrush x:Key="BgInput"       Color="#FAFBFC"/>
        <SolidColorBrush x:Key="BorderInput"   Color="#C5D0E0"/>
        <SolidColorBrush x:Key="TextPrimary"   Color="#1A2340"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#5A7BA8"/>
        <SolidColorBrush x:Key="TextMuted"     Color="#8A97AE"/>
        <SolidColorBrush x:Key="AccentBlue"    Color="#A8C4E8"/>
        <SolidColorBrush x:Key="Success"       Color="#2E7D32"/>
        <SolidColorBrush x:Key="SuccessBg"     Color="#E8F5E9"/>
        <SolidColorBrush x:Key="Warning"       Color="#E65100"/>
        <SolidColorBrush x:Key="WarningBg"     Color="#FFF3E0"/>
        <SolidColorBrush x:Key="ErrorClr"      Color="#C62828"/>
        <SolidColorBrush x:Key="ErrorBg"       Color="#FFEBEE"/>
        <SolidColorBrush x:Key="InfoBg"        Color="#E3F2FD"/>
        <SolidColorBrush x:Key="BtnCancelBg"   Color="#E8EEF7"/>

        <!-- ====================================================== -->
        <!-- Card style (white card with drop shadow)               -->
        <!-- ====================================================== -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background"     Value="{StaticResource BgCard}"/>
            <Setter Property="CornerRadius"   Value="6"/>
            <Setter Property="Padding"        Value="14,12"/>
            <Setter Property="Margin"         Value="0,0,0,10"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#CCCCCC" BlurRadius="6" ShadowDepth="1" Opacity="0.30"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Section label (navy, semibold) -->
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource NavyPrimary}"/>
            <Setter Property="Margin"     Value="0,0,0,8"/>
        </Style>

        <!-- Field label -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin"     Value="0,0,6,0"/>
        </Style>

        <!-- Status item icon label -->
        <Style x:Key="StatusIcon" TargetType="TextBlock">
            <Setter Property="FontSize"          Value="12"/>
            <Setter Property="Width"             Value="20"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Run button (navy, rounded) -->
        <Style x:Key="BtnRun" TargetType="Button">
            <Setter Property="Background"      Value="{StaticResource NavyPrimary}"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Height"          Value="36"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="5" Padding="18,0">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource NavyLight}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Cancel / secondary button -->
        <Style x:Key="BtnCancel" TargetType="Button">
            <Setter Property="Background"      Value="{StaticResource BtnCancelBg}"/>
            <Setter Property="Foreground"      Value="{StaticResource NavyPrimary}"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="Height"          Value="36"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="5" Padding="18,0">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#D0DCF0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tab control override — Urbana style -->
        <Style x:Key="UrbanaTab" TargetType="TabControl">
            <Setter Property="Background"    Value="{StaticResource BgPage}"/>
            <Setter Property="BorderBrush"   Value="{StaticResource BorderInput}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"       Value="0"/>
        </Style>

        <Style x:Key="UrbanaTabItem" TargetType="TabItem">
            <Setter Property="FontSize"      Value="12"/>
            <Setter Property="FontWeight"    Value="Normal"/>
            <Setter Property="Foreground"    Value="{StaticResource TextSecondary}"/>
            <Setter Property="Background"    Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"       Value="18,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder"
                                Background="{TemplateBinding Background}"
                                BorderThickness="0,0,0,2"
                                BorderBrush="Transparent"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="BorderBrush"
                                        Value="{StaticResource NavyPrimary}"/>
                                <Setter Property="Foreground" Value="{StaticResource NavyPrimary}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource NavyPrimary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBox matching Urbana input style -->
        <Style x:Key="UrbanaCombo" TargetType="ComboBox">
            <Setter Property="Background"               Value="{StaticResource BgInput}"/>
            <Setter Property="BorderBrush"              Value="{StaticResource BorderInput}"/>
            <Setter Property="BorderThickness"          Value="1"/>
            <Setter Property="Padding"                  Value="8,0"/>
            <Setter Property="FontSize"                 Value="11"/>
            <Setter Property="Height"                   Value="30"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- TextBox matching Urbana input style -->
        <Style x:Key="UrbanaTextBox" TargetType="TextBox">
            <Setter Property="Background"               Value="{StaticResource BgInput}"/>
            <Setter Property="BorderBrush"              Value="{StaticResource BorderInput}"/>
            <Setter Property="BorderThickness"          Value="1"/>
            <Setter Property="Padding"                  Value="8,0"/>
            <Setter Property="FontSize"                 Value="11"/>
            <Setter Property="Height"                   Value="30"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <!-- ================================================================ -->
    <!-- Root layout                                                       -->
    <!-- ================================================================ -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Header banner -->
            <RowDefinition Height="*"/>     <!-- Tab content   -->
            <RowDefinition Height="Auto"/>  <!-- Footer bar    -->
        </Grid.RowDefinitions>

        <!-- ============================================================ -->
        <!-- Header banner                                                 -->
        <!-- ============================================================ -->
        <Border Grid.Row="0"
                Background="{StaticResource NavyPrimary}"
                CornerRadius="0"
                Padding="20,14">
            <StackPanel>
                <TextBlock Text="⬡  Bridge Setup"
                           FontSize="17" FontWeight="Bold"
                           Foreground="White"/>
                <TextBlock Text="Urbana Bridge Generator  |  Bridge Configuration · Global Parameters · Reference Planes  |  Revit 2024"
                           FontSize="10.5"
                           Foreground="{StaticResource AccentBlue}"
                           Margin="0,3,0,0"/>
            </StackPanel>
        </Border>

        <!-- ============================================================ -->
        <!-- Tab control                                                   -->
        <!-- ============================================================ -->
        <TabControl Grid.Row="1"
                    x:Name="MainTabs"
                    Style="{StaticResource UrbanaTab}">

            <!-- ======================================================== -->
            <!-- ======================================================== -->
            <!-- TAB 1: Load Families                                      -->
            <!-- ======================================================== -->
            <TabItem Header="① Load Families"
                     Style="{StaticResource UrbanaTabItem}">
                <TabControl x:Name="LoadFamiliesSubTabs" Margin="8,8,8,0" Background="Transparent" BorderThickness="0">
                    <TabItem Header="Load Families" FontSize="11" Foreground="{StaticResource TextPrimary}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
        
                            <ScrollViewer Grid.Row="0"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"
                                          Padding="8,8,8,4">
                                <Border Background="{StaticResource BgCard}"
                                        CornerRadius="0,0,6,6"
                                        BorderBrush="{StaticResource BorderInput}"
                                        BorderThickness="1,0,1,1"
                                        Padding="14,10">
                                    <StackPanel>
                                        <TextBlock Text="Load Timber Deck Bridge families into the current document."
                                                   FontSize="10.5"
                                                   Foreground="{StaticResource TextSecondary}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,0,0,10"/>
        
                                        <!-- Beam row -->
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="60"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <CheckBox Grid.Column="0" x:Name="CbBeam"
                                                      IsChecked="True"
                                                      VerticalAlignment="Center"
                                                      Margin="0,0,8,0"/>
                                            <TextBlock Grid.Column="1" Text="Beam"
                                                       FontSize="11" VerticalAlignment="Center"
                                                       Foreground="{StaticResource TextPrimary}"
                                                       FontWeight="Normal"/>
                                            <TextBox Grid.Column="2" x:Name="BeamPathBox"
                                                     Style="{StaticResource UrbanaTextBox}"
                                                     Text="" FontSize="10"
                                                     ToolTip="Path to Beam .rfa family file"/>
                                            <Button Grid.Column="3" x:Name="BtnBrowseBeam"
                                                    Content="Browse…"
                                                    Style="{StaticResource BtnCancel}"
                                                    Height="30" FontSize="10"
                                                    Margin="6,0,0,0"/>
                                        </Grid>
                                        <Grid Margin="24,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="32"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Type" FontSize="10" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}"/>
                                            <ComboBox Grid.Column="1" x:Name="BeamTypeCombo" Style="{StaticResource UrbanaCombo}" Height="24" FontSize="10" IsEnabled="False">
                                                <ComboBoxItem Content="Select family first" IsSelected="True"/>
                                            </ComboBox>
                                        </Grid>
        
                                        <!-- Bearer row -->
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="60"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <CheckBox Grid.Column="0" x:Name="CbBearer"
                                                      IsChecked="True"
                                                      VerticalAlignment="Center"
                                                      Margin="0,0,8,0"/>
                                            <TextBlock Grid.Column="1" Text="Bearer"
                                                       FontSize="11" VerticalAlignment="Center"
                                                       Foreground="{StaticResource TextPrimary}"
                                                       FontWeight="Normal"/>
                                            <TextBox Grid.Column="2" x:Name="BearerPathBox"
                                                     Style="{StaticResource UrbanaTextBox}"
                                                     Text="" FontSize="10"
                                                     ToolTip="Path to Bearer .rfa family file"/>
                                            <Button Grid.Column="3" x:Name="BtnBrowseBearer"
                                                    Content="Browse…"
                                                    Style="{StaticResource BtnCancel}"
                                                    Height="30" FontSize="10"
                                                    Margin="6,0,0,0"/>
                                        </Grid>
                                        <Grid Margin="24,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="32"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Type" FontSize="10" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}"/>
                                            <ComboBox Grid.Column="1" x:Name="BearerTypeCombo" Style="{StaticResource UrbanaCombo}" Height="24" FontSize="10" IsEnabled="False">
                                                <ComboBoxItem Content="Select family first" IsSelected="True"/>
                                            </ComboBox>
                                        </Grid>
        
                                        <!-- Joist row -->
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="60"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <CheckBox Grid.Column="0" x:Name="CbJoist"
                                                      IsChecked="True"
                                                      VerticalAlignment="Center"
                                                      Margin="0,0,8,0"/>
                                            <TextBlock Grid.Column="1" Text="Joist"
                                                       FontSize="11" VerticalAlignment="Center"
                                                       Foreground="{StaticResource TextPrimary}"
                                                       FontWeight="Normal"/>
                                            <TextBox Grid.Column="2" x:Name="JoistPathBox"
                                                     Style="{StaticResource UrbanaTextBox}"
                                                     Text="" FontSize="10"
                                                     ToolTip="Path to Joist .rfa family file"/>
                                            <Button Grid.Column="3" x:Name="BtnBrowseJoist"
                                                    Content="Browse…"
                                                    Style="{StaticResource BtnCancel}"
                                                    Height="30" FontSize="10"
                                                    Margin="6,0,0,0"/>
                                        </Grid>
                                        <Grid Margin="24,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="32"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Type" FontSize="10" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}"/>
                                            <ComboBox Grid.Column="1" x:Name="JoistTypeCombo" Style="{StaticResource UrbanaCombo}" Height="24" FontSize="10" IsEnabled="False">
                                                <ComboBoxItem Content="Select family first" IsSelected="True"/>
                                            </ComboBox>
                                        </Grid>
        
                                        <!-- Packer row -->
                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="60"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <CheckBox Grid.Column="0" x:Name="CbPacker"
                                                      IsChecked="True"
                                                      VerticalAlignment="Center"
                                                      Margin="0,0,8,0"/>
                                            <TextBlock Grid.Column="1" Text="Packer"
                                                       FontSize="11" VerticalAlignment="Center"
                                                       Foreground="{StaticResource TextPrimary}"
                                                       FontWeight="Normal"/>
                                            <TextBox Grid.Column="2" x:Name="PackerPathBox"
                                                     Style="{StaticResource UrbanaTextBox}"
                                                     Text="" FontSize="10"
                                                     ToolTip="Path to Packer .rfa family file"/>
                                            <Button Grid.Column="3" x:Name="BtnBrowsePacker"
                                                    Content="Browse…"
                                                    Style="{StaticResource BtnCancel}"
                                                    Height="30" FontSize="10"
                                                    Margin="6,0,0,0"/>
                                        </Grid>
                                        <Grid Margin="24,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="32"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Type" FontSize="10" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}"/>
                                            <ComboBox Grid.Column="1" x:Name="PackerTypeCombo" Style="{StaticResource UrbanaCombo}" Height="24" FontSize="10" IsEnabled="False">
                                                <ComboBoxItem Content="Select family first" IsSelected="True"/>
                                            </ComboBox>
                                        </Grid>
        
                                        <!-- Load selected families action -->
                                        <Button x:Name="BtnLoadFamilies"
                                                Content="▶   Load Selected Families"
                                                Style="{StaticResource BtnRun}"
                                                HorizontalAlignment="Left"
                                                Width="220"
                                                Margin="0,0,0,8"/>
        
                                        <!-- Family load status -->
                                        <ItemsControl x:Name="FamilyStatusList">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" Margin="0,2">
                                                        <TextBlock Text="{Binding Icon}"
                                                                   Width="20" FontSize="12"
                                                                   Foreground="{Binding IconColor}"
                                                                   VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding Name}"
                                                                   Width="65" FontSize="11"
                                                                   Foreground="{StaticResource TextPrimary}"
                                                                   VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding Status}"
                                                                   Width="115" FontSize="11"
                                                                   Foreground="{Binding StatusColor}"
                                                                   FontWeight="SemiBold"
                                                                   VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding Detail}"
                                                                   FontSize="10"
                                                                   Foreground="{StaticResource TextMuted}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </ScrollViewer>
                        </Grid>
                    </TabItem>
                    
                    <TabItem Header="Parameter Mapping" FontSize="11" Foreground="{StaticResource TextPrimary}">
                        <Grid>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="8,8,8,4">
                                <StackPanel>
                                    <TextBlock Text="Map internal family parameters to logical component dimensions. You must load a family first."
                                               FontSize="10.5" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                                    
                                    <!-- Beam Mapping Panel -->
                                    <Border x:Name="BeamMappingPanel" Background="{StaticResource BgCard}" CornerRadius="4" BorderBrush="{StaticResource BorderInput}" BorderThickness="1" Padding="14,10" Margin="0,0,0,10" IsEnabled="False" Opacity="0.5">
                                        <StackPanel>
                                            <TextBlock Text="Beam" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,2"/>
                                            <TextBlock x:Name="BeamLoadedTypeLabel" Text="Loaded Type: (None)" FontSize="10" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,10"/>
                                            
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="100"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="60"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="Height" FontSize="10" VerticalAlignment="Center"/>
                                                <ComboBox Grid.Column="1" x:Name="BeamHeightCombo" Style="{StaticResource UrbanaCombo}" Height="24" FontSize="10"/>
                                                <TextBlock Grid.Column="2" x:Name="BeamHeightValue" Text="-" FontSize="10" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="{StaticResource TextSecondary}"/>
                                            </Grid>
                                            
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="100"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="60"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="Width" FontSize="10" VerticalAlignment="Center"/>
                                                <ComboBox Grid.Column="1" x:Name="BeamWidthCombo" Style="{StaticResource UrbanaCombo}" Height="24" FontSize="10"/>
                                                <TextBlock Grid.Column="2" x:Name="BeamWidthValue" Text="-" FontSize="10" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="{StaticResource TextSecondary}"/>
                                            </Grid>
                                            
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="100"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="60"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="Web Thickness" FontSize="10" VerticalAlignment="Center"/>
                                                <ComboBox Grid.Column="1" x:Name="BeamWebCombo" Style="{StaticResource UrbanaCombo}" Height="24" FontSize="10"/>
                                                <TextBlock Grid.Column="2" x:Name="BeamWebValue" Text="-" FontSize="10" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="{StaticResource TextSecondary}"/>
                                            </Grid>

                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="100"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="60"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="Flange Thickness" FontSize="10" VerticalAlignment="Center"/>
                                                <ComboBox Grid.Column="1" x:Name="BeamFlangeCombo" Style="{StaticResource UrbanaCombo}" Height="24" FontSize="10"/>
                                                <TextBlock Grid.Column="2" x:Name="BeamFlangeValue" Text="-" FontSize="10" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="{StaticResource TextSecondary}"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                    
                                    <!-- Bearer Mapping Panel -->
                                    <Border x:Name="BearerMappingPanel" Background="{StaticResource BgCard}" CornerRadius="4" BorderBrush="{StaticResource BorderInput}" BorderThickness="1" Padding="14,10" Margin="0,0,0,10" IsEnabled="False" Opacity="0.5">
                                        <StackPanel>
                                            <TextBlock Text="Bearer" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,2"/>
                                            <TextBlock x:Name="BearerLoadedTypeLabel" Text="Loaded Type: (None)" FontSize="10" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,10"/>
                                            
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="100"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="60"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="Width" FontSize="10" VerticalAlignment="Center"/>
                                                <ComboBox Grid.Column="1" x:Name="BearerWidthCombo" Style="{StaticResource UrbanaCombo}" Height="24" FontSize="10"/>
                                                <TextBlock Grid.Column="2" x:Name="BearerWidthValue" Text="-" FontSize="10" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="{StaticResource TextSecondary}"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                    
                                    <!-- Joist Mapping Panel -->
                                    <Border x:Name="JoistMappingPanel" Background="{StaticResource BgCard}" CornerRadius="4" BorderBrush="{StaticResource BorderInput}" BorderThickness="1" Padding="14,10" Margin="0,0,0,10" IsEnabled="False" Opacity="0.5">
                                        <StackPanel>
                                            <TextBlock Text="Joist" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,2"/>
                                            <TextBlock x:Name="JoistLoadedTypeLabel" Text="Loaded Type: (None)" FontSize="10" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,10"/>
                                            
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="100"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="60"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="Height" FontSize="10" VerticalAlignment="Center"/>
                                                <ComboBox Grid.Column="1" x:Name="JoistHeightCombo" Style="{StaticResource UrbanaCombo}" Height="24" FontSize="10"/>
                                                <TextBlock Grid.Column="2" x:Name="JoistHeightValue" Text="-" FontSize="10" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="{StaticResource TextSecondary}"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                    
                                    <!-- Packer Mapping Panel -->
                                    <Border x:Name="PackerMappingPanel" Background="{StaticResource BgCard}" CornerRadius="4" BorderBrush="{StaticResource BorderInput}" BorderThickness="1" Padding="14,10" Margin="0,0,0,10" IsEnabled="False" Opacity="0.5">
                                        <StackPanel>
                                            <TextBlock Text="Packer" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,2"/>
                                            <TextBlock x:Name="PackerLoadedTypeLabel" Text="Loaded Type: (None)" FontSize="10" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,10"/>
                                            
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="100"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="60"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="Height" FontSize="10" VerticalAlignment="Center"/>
                                                <ComboBox Grid.Column="1" x:Name="PackerHeightCombo" Style="{StaticResource UrbanaCombo}" Height="24" FontSize="10"/>
                                                <TextBlock Grid.Column="2" x:Name="PackerHeightValue" Text="-" FontSize="10" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="{StaticResource TextSecondary}"/>
                                            </Grid>
                                            
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="100"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="60"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="Width" FontSize="10" VerticalAlignment="Center"/>
                                                <ComboBox Grid.Column="1" x:Name="PackerWidthCombo" Style="{StaticResource UrbanaCombo}" Height="24" FontSize="10"/>
                                                <TextBlock Grid.Column="2" x:Name="PackerWidthValue" Text="-" FontSize="10" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="{StaticResource TextSecondary}"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                    <!-- Apply Mapping Action -->
                                    <Button x:Name="BtnApplyMapping"
                                            Content="Apply Parameter Mapping"
                                            Style="{StaticResource BtnRun}"
                                            HorizontalAlignment="Left"
                                            Width="220"
                                            Margin="0,10,0,8"/>
                                            
                                    <TextBlock x:Name="MappingStatusText"
                                               Text="Pending application..."
                                               FontSize="11" Foreground="{StaticResource TextSecondary}"
                                               Margin="0,0,0,10" TextWrapping="Wrap"/>
                                               
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </TabItem>
                </TabControl>
            </TabItem>
                        <!-- TAB 2: Bridge Configuration                               -->
            <!-- ======================================================== -->
            <TabItem Header="② Bridge Configuration"
                     Style="{StaticResource UrbanaTabItem}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <ScrollViewer Grid.Row="0"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Padding="16,12,16,4">
                        <StackPanel>

                            <!-- Bridge type / config type read-only badge -->
                            <Border Background="{StaticResource InfoBg}"
                                    CornerRadius="6" Padding="14,10" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                        <TextBlock Text="BRIDGE TYPE"
                                                   FontSize="9" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextMuted}"
                                                   Margin="0,0,0,3"/>
                                        <TextBlock Text="Timber Deck Bridge"
                                                   FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{StaticResource NavyPrimary}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="CONFIGURATION TYPE"
                                                   FontSize="9" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextMuted}"
                                                   Margin="0,0,0,3"/>
                                        <TextBlock Text="CRNK — Cranked"
                                                   FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{StaticResource NavyPrimary}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Bridge Inputs card -->
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Bridge Inputs"
                                               Style="{StaticResource SectionLabel}"/>

                                    <!-- Span -->
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Span"
                                                   Style="{StaticResource FieldLabel}"/>
                                        <ComboBox Grid.Column="1" x:Name="SpanCombo"
                                                  Style="{StaticResource UrbanaCombo}"/>
                                    </Grid>

                                    <!-- Width -->
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Width"
                                                   Style="{StaticResource FieldLabel}"/>
                                        <ComboBox Grid.Column="1" x:Name="WidthCombo"
                                                  Style="{StaticResource UrbanaCombo}"/>
                                    </Grid>

                                    <!-- Configuration -->
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Configuration"
                                                   Style="{StaticResource FieldLabel}"/>
                                        <ComboBox Grid.Column="1" x:Name="ConfigCombo"
                                                  Style="{StaticResource UrbanaCombo}"/>
                                    </Grid>

                                    <!-- Camber -->
                                    <Grid Margin="0,0,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Camber"
                                                   Style="{StaticResource FieldLabel}"/>
                                        <TextBox Grid.Column="1" x:Name="CamberBox"
                                                 Style="{StaticResource UrbanaTextBox}"
                                                 Text="20"/>
                                        <TextBlock Grid.Column="2" Text=" mm"
                                                   FontSize="11"
                                                   Foreground="{StaticResource TextSecondary}"
                                                   VerticalAlignment="Center"
                                                   Margin="6,0,0,0"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Derived Parameters preview card -->
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Derived Parameters"
                                               Style="{StaticResource SectionLabel}"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="24"/>
                                            <RowDefinition Height="24"/>
                                            <RowDefinition Height="24"/>
                                            <RowDefinition Height="24"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0"
                                                   Text="Length" FontSize="11"
                                                   Foreground="{StaticResource TextSecondary}"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Grid.Row="0" Grid.Column="1"
                                                   x:Name="DerivedLength" Text="—"
                                                   FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{StaticResource NavyPrimary}"
                                                   VerticalAlignment="Center"/>

                                        <TextBlock Grid.Row="1" Grid.Column="0"
                                                   Text="Clear Span" FontSize="11"
                                                   Foreground="{StaticResource TextSecondary}"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Grid.Row="1" Grid.Column="1"
                                                   x:Name="DerivedClearSpan" Text="—"
                                                   FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{StaticResource NavyPrimary}"
                                                   VerticalAlignment="Center"/>

                                        <TextBlock Grid.Row="2" Grid.Column="0"
                                                   Text="Crank Length" FontSize="11"
                                                   Foreground="{StaticResource TextSecondary}"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Grid.Row="2" Grid.Column="1"
                                                   x:Name="DerivedCrankLen" Text="—"
                                                   FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{StaticResource NavyPrimary}"
                                                   VerticalAlignment="Center"/>

                                        <TextBlock Grid.Row="3" Grid.Column="0"
                                                   Text="Camber" FontSize="11"
                                                   Foreground="{StaticResource TextSecondary}"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Grid.Row="3" Grid.Column="1"
                                                   x:Name="DerivedCamber" Text="—"
                                                   FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{StaticResource NavyPrimary}"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Applied Configuration status (hidden until first Apply) -->
                            <Border x:Name="ConfigStatusCard"
                                    Style="{StaticResource Card}"
                                    Visibility="Collapsed">
                                <StackPanel>
                                    <TextBlock Text="Applied Configuration"
                                               Style="{StaticResource SectionLabel}"/>
                                    <ItemsControl x:Name="ConfigStatusList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,3">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="20"/>
                                                        <ColumnDefinition Width="130"/>
                                                        <ColumnDefinition Width="80"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0"
                                                               Text="{Binding Icon}"
                                                               FontSize="12"
                                                               Foreground="{Binding IconColor}"
                                                               VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding Name}"
                                                               FontSize="11"
                                                               Foreground="{StaticResource TextPrimary}"
                                                               VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="2"
                                                               Text="{Binding Status}"
                                                               FontSize="11"
                                                               Foreground="{Binding StatusColor}"
                                                               FontWeight="SemiBold"
                                                               VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="3"
                                                               Text="{Binding Detail}"
                                                               FontSize="10"
                                                               Foreground="{StaticResource TextMuted}"
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding Detail}"
                                                               VerticalAlignment="Center"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>



                        </StackPanel>
                    </ScrollViewer>

                    <!-- Tab ① action button -->
                    <Border Grid.Row="1"
                            Background="{StaticResource BgCard}"
                            BorderBrush="{StaticResource BorderInput}"
                            BorderThickness="0,1,0,0"
                            Padding="16,10">
                        <Button x:Name="BtnApplyConfig"
                                Content="▶   Apply Bridge Configuration"
                                Style="{StaticResource BtnRun}"/>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ======================================================== -->
            <!-- TAB 3: Global Parameters                                  -->
            <!-- ======================================================== -->
            <TabItem Header="③ Global Parameters"
                     Style="{StaticResource UrbanaTabItem}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <ScrollViewer Grid.Row="0"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Padding="16,12,16,4">
                        <StackPanel>
                            <!-- Info card -->
                            <Border Background="{StaticResource InfoBg}"
                                    CornerRadius="6" Padding="12,10" Margin="0,0,0,10">
                                <TextBlock TextWrapping="Wrap" FontSize="11"
                                           Foreground="{StaticResource NavyPrimary}">
                                    Creates or validates all <Bold>25 Global Parameters</Bold>
                                    (Construction · Dimensions · Other) with exact names,
                                    values, and formulas. Safe to re-run — no duplicates created.
                                </TextBlock>
                            </Border>

                            <!-- Status card -->
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Parameter Status"
                                               Style="{StaticResource SectionLabel}"/>
                                    <Border Background="{StaticResource BgInput}"
                                            CornerRadius="4"
                                            BorderBrush="{StaticResource BorderInput}"
                                            BorderThickness="1"
                                            MinHeight="260" Padding="2">
                                        <ListView x:Name="ParamStatusList"
                                                  BorderThickness="0"
                                                  Background="Transparent"
                                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                  FontSize="11">
                                            <ListView.View>
                                                <GridView>
                                                    <GridViewColumn Width="28">
                                                        <GridViewColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding Icon}"
                                                                           Style="{StaticResource StatusIcon}"
                                                                           Foreground="{Binding IconColor}"/>
                                                            </DataTemplate>
                                                        </GridViewColumn.CellTemplate>
                                                    </GridViewColumn>
                                                    <GridViewColumn Header="Parameter" Width="220">
                                                        <GridViewColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding Name}"
                                                                           FontSize="11"
                                                                           Foreground="{StaticResource TextPrimary}"
                                                                           TextTrimming="CharacterEllipsis"/>
                                                            </DataTemplate>
                                                        </GridViewColumn.CellTemplate>
                                                    </GridViewColumn>
                                                    <GridViewColumn Header="Status" Width="110">
                                                        <GridViewColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding Status}"
                                                                           FontSize="11"
                                                                           Foreground="{Binding StatusColor}"
                                                                           FontWeight="SemiBold"/>
                                                            </DataTemplate>
                                                        </GridViewColumn.CellTemplate>
                                                    </GridViewColumn>
                                                    <GridViewColumn Header="Detail" Width="180">
                                                        <GridViewColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding Detail}"
                                                                           FontSize="10"
                                                                           Foreground="{StaticResource TextMuted}"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           ToolTip="{Binding Detail}"/>
                                                            </DataTemplate>
                                                        </GridViewColumn.CellTemplate>
                                                    </GridViewColumn>
                                                </GridView>
                                            </ListView.View>
                                        </ListView>
                                    </Border>
                                    <!-- Summary label -->
                                    <TextBlock x:Name="ParamSummaryLabel"
                                               Text="Click the button below to create or validate all 25 parameters."
                                               FontSize="10.5"
                                               Foreground="{StaticResource TextSecondary}"
                                               Margin="0,8,0,0"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Tab 1 action button -->
                    <Border Grid.Row="1"
                            Background="{StaticResource BgCard}"
                            BorderBrush="{StaticResource BorderInput}"
                            BorderThickness="0,1,0,0"
                            Padding="16,10">
                        <Button x:Name="BtnCreateParams"
                                Content="▶   Create / Update Global Parameters"
                                Style="{StaticResource BtnRun}"/>
                    </Border>
                </Grid>
            </TabItem>

            <!-- TAB 4: Reference Planes                                   -->
            <!-- ======================================================== -->
            <TabItem Header="④ Reference Planes"
                     Style="{StaticResource UrbanaTabItem}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <ScrollViewer Grid.Row="0"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Padding="16,12,16,4">
                        <StackPanel>
                            <!-- Required GP validation card -->
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Required Global Parameters"
                                               Style="{StaticResource SectionLabel}"/>
                                    <TextBlock TextWrapping="Wrap" FontSize="10.5"
                                               Foreground="{StaticResource TextSecondary}"
                                               Margin="0,0,0,8">
                                        The following 6 Global Parameters must exist
                                        (run Tab ① first if any show as missing).
                                    </TextBlock>
                                    <ItemsControl x:Name="RequiredGPList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                                    <TextBlock Text="{Binding Icon}"
                                                               Width="20" FontSize="12"
                                                               Foreground="{Binding IconColor}"
                                                               VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding Name}"
                                                               FontSize="11"
                                                               Foreground="{Binding StatusColor}"
                                                               VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- Origin info card -->
                            <Border x:Name="OriginInfoCard"
                                    Background="{StaticResource InfoBg}"
                                    CornerRadius="6" Padding="12,8" Margin="0,0,0,10">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⊙ " FontSize="13"
                                               Foreground="{StaticResource NavyPrimary}"
                                               VerticalAlignment="Center"/>
                                    <TextBlock x:Name="OriginInfoText"
                                               Text="Bridge center: (not yet resolved)"
                                               FontSize="11"
                                               Foreground="{StaticResource NavyPrimary}"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <!-- Plane/dimension status card -->
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Reference Plane &amp; Dimension Status"
                                               Style="{StaticResource SectionLabel}"/>
                                    <Border Background="{StaticResource BgInput}"
                                            CornerRadius="4"
                                            BorderBrush="{StaticResource BorderInput}"
                                            BorderThickness="1"
                                            MinHeight="200" Padding="2">
                                        <ListView x:Name="PlaneStatusList"
                                                  BorderThickness="0"
                                                  Background="Transparent"
                                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                  FontSize="11">
                                            <ListView.View>
                                                <GridView>
                                                    <GridViewColumn Width="28">
                                                        <GridViewColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding Icon}"
                                                                           Style="{StaticResource StatusIcon}"
                                                                           Foreground="{Binding IconColor}"/>
                                                            </DataTemplate>
                                                        </GridViewColumn.CellTemplate>
                                                    </GridViewColumn>
                                                    <GridViewColumn Header="Element" Width="200">
                                                        <GridViewColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding Name}"
                                                                           FontSize="11"
                                                                           Foreground="{StaticResource TextPrimary}"
                                                                           TextTrimming="CharacterEllipsis"/>
                                                            </DataTemplate>
                                                        </GridViewColumn.CellTemplate>
                                                    </GridViewColumn>
                                                    <GridViewColumn Header="Status" Width="110">
                                                        <GridViewColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding Status}"
                                                                           FontSize="11"
                                                                           Foreground="{Binding StatusColor}"
                                                                           FontWeight="SemiBold"/>
                                                            </DataTemplate>
                                                        </GridViewColumn.CellTemplate>
                                                    </GridViewColumn>
                                                    <GridViewColumn Header="Detail" Width="190">
                                                        <GridViewColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding Detail}"
                                                                           FontSize="10"
                                                                           Foreground="{StaticResource TextMuted}"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           ToolTip="{Binding Detail}"/>
                                                            </DataTemplate>
                                                        </GridViewColumn.CellTemplate>
                                                    </GridViewColumn>
                                                </GridView>
                                            </ListView.View>
                                        </ListView>
                                    </Border>
                                    <TextBlock x:Name="PlaneSummaryLabel"
                                               Text="Click the button below to create or validate the reference plane skeleton."
                                               FontSize="10.5"
                                               Foreground="{StaticResource TextSecondary}"
                                               Margin="0,8,0,0"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Tab 2 action button -->
                    <Border Grid.Row="1"
                            Background="{StaticResource BgCard}"
                            BorderBrush="{StaticResource BorderInput}"
                            BorderThickness="0,1,0,0"
                            Padding="16,10">
                        <Button x:Name="BtnCreatePlanes"
                                Content="▶   Create / Update Reference Planes"
                                Style="{StaticResource BtnRun}"/>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- ============================================================ -->
        <!-- Footer bar                                                    -->
        <!-- ============================================================ -->
        <Border Grid.Row="2"
                Background="{StaticResource BgCard}"
                BorderBrush="{StaticResource BorderInput}"
                BorderThickness="0,1,0,0"
                Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="FooterStatus"
                           Grid.Column="0"
                           Text="Ready."
                           FontSize="10.5"
                           Foreground="{StaticResource TextMuted}"
                           VerticalAlignment="Center"/>
                <Button x:Name="BtnClose"
                        Grid.Column="1"
                        Content="Close"
                        Style="{StaticResource BtnCancel}"/>
            </Grid>
        </Border>
    </Grid>
</Window>
